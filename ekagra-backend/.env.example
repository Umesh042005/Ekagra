# Copy this file to .env and fill in real values (never commit .env)
# Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-key

# AI assistant (chatbot). Leave AI_API_KEY empty to run in demo mode.
# Ollama Cloud: create a key at https://ollama.com/settings/keys
# Pick a model from https://ollama.com/search?c=cloud
AI_API_URL=https://ollama.com/api/chat
AI_API_KEY=
AI_MODEL=

# Server settings (optional)
HOST=127.0.0.1
PORT=8000
